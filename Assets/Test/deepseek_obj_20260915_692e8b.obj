vt 0.250000 0.750000

# ==================== ГРАНИ ====================
# Фундамент (нижняя часть)
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/1/2 6/2/2 7/3/2 8/4/2
f 1/1/3 2/2/3 5/3/3 6/4/3
f 3/1/4 4/2/4 7/3/4 8/4/4
f 1/1/5 4/2/5 3/3/5 2/4/5
f 5/1/6 6/2/6 7/3/6 8/4/6

# Здесь ты можешь продолжить грани для остальных блоков...
# (Для краткости я показал принцип, полный файл будет очень длинным)

# ==================== МАТЕРИАЛЫ ====================
usemtl cobblestone
usemtl oak_planks
usemtl oak_log
usemtl stone_slab